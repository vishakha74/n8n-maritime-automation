# Copy to .env and fill in. Never commit .env.

# Maersk Vessel Schedules API
MAERSK_CONSUMER_KEY=your_maersk_consumer_key
MAERSK_VESSEL_CODE=your_vessel_code

# n8n
N8N_BASE_URL=http://localhost:5678
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# Local airport data (download from https://ourairports.com/data/)
AIRPORTS_CSV_PATH=C:\n8n-data\airports.csv

# Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# WhatsApp (workflow 01)
WHATSAPP_GROUP_JID=1234567890@g.us
